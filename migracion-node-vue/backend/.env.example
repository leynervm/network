PORT=4000
NODE_ENV=development

# ========================================================
# GESTOR DE BASE DE DATOS (mysql o postgres)
# ========================================================
# Configuración para MySQL (Laragon / XAMPP):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=network
# DB_USERNAME=root
# DB_PASSWORD=

# Configuración para PostgreSQL:
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=network
DB_USERNAME=postgres
DB_PASSWORD=12345
DB_SSL=false

# Sincronización automática de esquema TypeORM (false por defecto)
# DB_SYNCHRONIZE=false

# Autenticación JWT y Sesión
JWT_SECRET=network_jwt_secret_token_key_fidelidad_1_a_1
JWT_EXPIRES_IN=7d
COOKIE_NAME=network_auth_token

# URL del Frontend para CORS y Cookies
FRONTEND_URL=http://localhost:5173

# Servicios externos (SUNAT / RENIEC / YAPE)
API_SUNAT_TOKEN=
API_SUNAT_URL_RUC=https://api.apis.net.pe/v1/ruc?numero=
API_SUNAT_URL_DNI=https://api.apis.net.pe/v1/dni?numero=
YAPE_BASE_QR=
YAPE_PHONE=
